WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
PORT=3000

# Discord OAuth app (discord.com/developers/applications). Register both
# redirect URIs below on the app's OAuth2 page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Your own Discord user ID (Discord app -> User Settings -> Advanced -> turn
# on Developer Mode, then right-click your name anywhere -> Copy User ID).
# This ID is always granted admin on login, even if someone else's admin
# flag is manually toggled off/on from the Users admin page.
ADMIN_DISCORD_ID=

# Any long random string, used to sign the session cookie.
SESSION_COOKIE_SECRET=

# Set to "production" in deployment so session cookies require HTTPS.
NODE_ENV=development

# Only needed for the docker-compose "cloudflared" service in production -
# generated when you create a Tunnel in the Cloudflare Zero Trust dashboard.
TUNNEL_TOKEN=
